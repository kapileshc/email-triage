APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8001
ALLOWED_ORIGINS=http://localhost:5173

# Azure Foundry serverless chat model
AZURE_MODEL_ENDPOINT=https://YOUR-MODEL-ENDPOINT
AZURE_MODEL_API_KEY=
AZURE_MODEL_NAME=Phi-4
AZURE_MODEL_MAX_TOKENS=600

# Azure Foundry / Azure AI embedding deployment
AZURE_EMBEDDING_ENDPOINT=https://YOUR-EMBEDDING-ENDPOINT
AZURE_EMBEDDING_API_KEY=
AZURE_EMBEDDING_MODEL=

# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-DOCINTEL-RESOURCE.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_MODEL=prebuilt-read

# Qdrant Cloud
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=email_triage_knowledge
TOP_K=4

# Attachment limits keep the t3.micro lightweight
MAX_ATTACHMENT_MB=4
MAX_ATTACHMENTS=5
